# Lychee link checker config
# https://github.com/lycheeverse/lychee

# Treat as failures
no-progress = true
exclude-mail = true

# Don't fail on rate limits (some hosts return 429 for bots; not actually broken)
accept = [200, 206, 301, 302, 304, 308, 403, 429]

# Skip these domains entirely — known to block crawlers or rate-limit aggressively
exclude = [
  "^https://twitter\\.com/",
  "^https://x\\.com/",
  "^https://linkedin\\.com/",
  "^https://www\\.linkedin\\.com/",
  # Localhost / private network refs in examples
  "^https?://localhost",
  "^https?://127\\.0\\.0\\.1",
  "^https?://0\\.0\\.0\\.0",
  # Example.com used in spec illustrations
  "^https?://(?:[a-z0-9-]+\\.)?example\\.(com|org|net)",
  # DID URIs are not URLs
  "^did:",
]

# Internal anchor checks
include-fragments = true

# Reasonable timeout
timeout = 20

# Be polite
max-concurrency = 8
